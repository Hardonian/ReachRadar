# ==========================================
# ReachRadar Environment Configuration
# ==========================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT=3000

# Supabase / PostgreSQL Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# Application-Level Token Encryption (AES-256-GCM)
# 32-byte hexadecimal string
TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
TOKEN_ENCRYPTION_KEY_VERSION="v1"

# Google / YouTube OAuth & Analytics API
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-secret"
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/v1/auth/google/callback"

# Stripe Commercial Billing
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Google Gemini API (Optional for narrative intelligence formatting)
GEMINI_API_KEY=""

# Background Job Queue & Cron Security
CRON_SECRET="reachradar_secret_cron_token_change_in_production"
