{
  "name": "@reachradar/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts || true",
    "test": "vitest run",
    "test:unit": "vitest run tests/encryption.test.ts tests/queue.test.ts",
    "test:rls": "vitest run tests/rls.test.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@reachradar/config": "workspace:*",
    "@reachradar/domain": "workspace:*",
    "@supabase/supabase-js": "^2.49.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
